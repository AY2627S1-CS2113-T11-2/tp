@startuml
!include style.puml
participant ":CommandManager" as CM
participant "<<class>>\nAddCommand" as AC
participant ":AddCommand" as A
participant ":Module" as M
participant ":Student" as S

[-> CM : processQuery("add m/CS2113 c/4 g/A-")
activate CM
CM -> AC : parse(query)
activate AC
create A
AC -> A : new AddCommand(...)
AC --> CM : Optional.of(command)
deactivate AC
CM -> A : execute(student)
activate A
create M
A -> M : new Module(...)
activate M
M --> A : module
deactivate M
A -> S : addModule(module)
activate S
S -> S : isModuleExists(moduleCode)
alt [module already exists]
  S --> A : throws DuplicateModuleException
else [module code is unique]
  S -> S : moduleList.add(module)
  S --> A : completed
  A --> CM : Response
end
deactivate S
deactivate A
CM -->] : Response / exception
deactivate CM
@enduml
