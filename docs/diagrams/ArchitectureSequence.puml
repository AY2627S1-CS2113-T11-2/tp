@startuml
!include style.puml

participant ":ChatGpat" as Main
participant ":ChatInterface" as UI
participant ":CommandManager" as CM
participant "<<class>>\nAddCommand" as AC
participant ":AddCommand" as A
participant ":Module" as M
participant ":Student" as S

activate Main
Main -> UI ++ : printWelcome()
UI --> Main --

loop until terminated
    Main -> UI ++ : getUserQuery()
    UI --> Main -- : "add m/CS2113 c/4 g/A-"

    Main -> CM ++ : processQuery(query)
    CM -> AC ++ : parse(query)
    create A
    AC -> A : AddCommand(...)
    activate A
    A --> AC
    deactivate A
    AC --> CM -- : Optional.of(command)

    CM -> A ++ : execute(student)
    create M
    A -> M : Module(...)
    activate M
    M --> A
    deactivate M
    A -> S ++ : addModule(module)
    S --> A --
    A --> CM -- : Response
    destroy A
    CM --> Main -- : Response

    Main -> UI ++ : printResponse(response)
    UI --> Main --
end
deactivate Main
@enduml
